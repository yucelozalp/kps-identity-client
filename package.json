{
  "name": "@yucelozalp/kps-identity-client",
  "version": "1.1.0",
  "description": "Professional Turkish National Identity (TC Kimlik) verification client for Node.js - KPS v2 TumKutukDogrulaServis (2025/08/01) integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src examples",
    "lint:fix": "eslint src examples --fix",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "kps",
    "nvi",
    "tc-kimlik",
    "tc-identity",
    "turkish-id",
    "identity-verification",
    "turkey",
    "soap",
    "ws-trust",
    "kimlik-dogrulama",
    "nufus",
    "mernis",
    "tckk",
    "kimlik-karti",
    "tum-kutuk-dogrulama",
    "typescript"
  ],
  "author": {
    "name": "Yücel Özalp",
    "email": "yuozalp@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yucelozalp/kps-identity-client.git"
  },
  "bugs": {
    "url": "https://github.com/yucelozalp/kps-identity-client/issues"
  },
  "homepage": "https://github.com/yucelozalp/kps-identity-client#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.0",
    "@types/xml2js": "^0.4.14",
    "@xmldom/xmldom": "^0.8.12",
    "eslint": "^9.39.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "xml-crypto": "^6.4.0"
  },
  "sideEffects": false
}
