{
  "name": "@yucelozalp/kps-identity-client",
  "version": "1.0.1",
  "description": "Professional Turkish National Identity (TC Kimlik) verification client for Node.js - KPS v2 API integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "kps",
    "nvi",
    "tc-kimlik",
    "tc-identity",
    "turkish-id",
    "identity-verification",
    "turkey",
    "soap",
    "ws-trust",
    "kimlik-dogrulama",
    "nufus",
    "mernis"
  ],
  "author": {
    "name": "Yücel Özalp",
    "email": "yuozalp@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yucelozalp/kps-identity-client.git"
  },
  "bugs": {
    "url": "https://github.com/yucelozalp/kps-identity-client/issues"
  },
  "homepage": "https://github.com/yucelozalp/kps-identity-client#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "uuid": "^11.0.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}